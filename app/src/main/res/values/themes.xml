<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SpendWise" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorError">@color/status_expense</item>

        <item name="materialButtonStyle">@style/Widget.SpendWise.Button</item>
        <item name="materialCardViewStyle">@style/Widget.SpendWise.Card</item>
        <item name="textInputStyle">@style/Widget.SpendWise.TextInputLayout</item>
        <item name="bottomSheetDialogTheme">@style/Theme.SpendWise.BottomSheet</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.SpendWise" parent="Base.Theme.SpendWise">
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <!-- The status bar sits on the dark teal hero, so its icons stay light. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- The navigation bar sits on the pale app background, so its icons go dark. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.SpendWise.Auth" parent="Theme.SpendWise">
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="Theme.SpendWise.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SpendWise.BottomSheet</item>
    </style>

    <style name="Widget.SpendWise.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.SpendWise.BottomSheet</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="ShapeAppearance.SpendWise.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/corner_radius_xl</item>
        <item name="cornerSizeTopRight">@dimen/corner_radius_xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.SpendWise.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/ripple_on_brand</item>
    </style>

    <style name="Widget.SpendWise.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
    </style>

    <style name="Widget.SpendWise.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">@dimen/corner_radius_pill</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SpendWise.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.SpendWise.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="errorEnabled">true</item>
        <item name="errorIconDrawable">@null</item>
    </style>

    <style name="Widget.SpendWise.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <style name="Widget.SpendWise.Card.Flat" parent="Widget.SpendWise.Card">
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_container_high</item>
    </style>

    <style name="Widget.SpendWise.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="chipCornerRadius">@dimen/corner_radius_pill</item>
    </style>

    <!-- ===================== Type scale ===================== -->

    <style name="TextAppearance.SpendWise.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SpendWise.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SpendWise.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SpendWise.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.SpendWise.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.SpendWise.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.SpendWise.Amount" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_amount</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.SpendWise.Amount.Hero" parent="TextAppearance.SpendWise.Amount">
        <item name="android:textSize">@dimen/text_hero_amount</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
