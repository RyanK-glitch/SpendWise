<?xml version="1.0" encoding="utf-8"?>
<!-- Entry screen. Three steps: direction and amount, category and method, then date and note. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_background"
        app:contentInsetStart="@dimen/spacing_xs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/spacing_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/add_transaction_title"
            android:textAppearance="@style/TextAppearance.SpendWise.Title" />
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/spacing_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <TextView
            android:id="@+id/textStepLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SpendWise.SectionLabel"
            tools:text="Step 1 of 3" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:contentDescription="@string/bt_cd_step_progress"
            android:max="3"
            android:progress="1"
            app:indicatorColor="@color/brand_primary"
            app:trackColor="@color/surface_container_high"
            app:trackCornerRadius="@dimen/corner_radius_pill"
            app:trackThickness="@dimen/progress_track_height" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollSteps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/spacing_lg"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/dividerButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutProgress"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingEnd="@dimen/screen_horizontal_padding">

            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_step_type"
                    android:textAppearance="@style/TextAppearance.SpendWise.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/bt_add_type_caption"
                    android:textAppearance="@style/TextAppearance.SpendWise.Body" />

                <LinearLayout
                    android:id="@+id/toggleType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonExpense"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="104dp"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:letterSpacing="0"
                        android:maxLines="1"
                        android:text="@string/transactions_type_expense"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.SpendWise.Body"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/corner_radius_lg"
                        app:icon="@drawable/ic_arrow_up_right"
                        app:iconGravity="top"
                        app:iconPadding="@dimen/spacing_sm"
                        app:iconSize="@dimen/icon_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonIncome"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="104dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:letterSpacing="0"
                        android:maxLines="1"
                        android:text="@string/transactions_type_income"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.SpendWise.Body"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/corner_radius_lg"
                        app:icon="@drawable/ic_arrow_down_left"
                        app:iconGravity="top"
                        app:iconPadding="@dimen/spacing_sm"
                        app:iconSize="@dimen/icon_md" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/add_category"
                    android:textAppearance="@style/TextAppearance.SpendWise.SectionLabel" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:chipSpacingHorizontal="@dimen/spacing_sm"
                    app:chipSpacingVertical="@dimen/spacing_xs"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_step_details"
                    android:textAppearance="@style/TextAppearance.SpendWise.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/bt_add_details_caption"
                    android:textAppearance="@style/TextAppearance.SpendWise.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/bt_add_amount_label"
                    android:textAppearance="@style/TextAppearance.SpendWise.SectionLabel" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutAmount"
                    style="@style/Widget.SpendWise.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/add_amount"
                    app:boxBackgroundColor="@color/surface"
                    app:prefixText="LKR"
                    app:prefixTextAppearance="@style/TextAppearance.SpendWise.Amount"
                    app:prefixTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:inputType="numberDecimal"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingTop="@dimen/spacing_md"
                        android:paddingBottom="@dimen/spacing_md"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.SpendWise.Display"
                        android:textColor="@color/text_primary"
                        tools:text="42.15" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutDescription"
                    style="@style/Widget.SpendWise.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/add_description"
                    app:boxBackgroundColor="@color/surface">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:minHeight="@dimen/touch_target_min"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.SpendWise.Body"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutDate"
                    style="@style/Widget.SpendWise.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/add_date"
                    app:boxBackgroundColor="@color/surface"
                    app:endIconContentDescription="@string/add_date"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:textAppearance="@style/TextAppearance.SpendWise.Body"
                        android:textColor="@color/text_primary"
                        tools:text="12 Aug 2026" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/add_payment_method"
                    android:textAppearance="@style/TextAppearance.SpendWise.SectionLabel" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:chipSpacingHorizontal="@dimen/spacing_sm"
                    app:chipSpacingVertical="@dimen/spacing_xs"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutNote"
                    style="@style/Widget.SpendWise.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/add_note"
                    app:boxBackgroundColor="@color/surface">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:minHeight="@dimen/touch_target_min"
                        android:textAppearance="@style/TextAppearance.SpendWise.Body"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/add_step_confirm"
                    android:textAppearance="@style/TextAppearance.SpendWise.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/bt_add_review_caption"
                    android:textAppearance="@style/TextAppearance.SpendWise.Body" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSummary"
                    style="@style/Widget.SpendWise.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    app:contentPadding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSummaryAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.SpendWise.Display"
                            android:textColor="@color/status_expense"
                            app:autoSizeMaxTextSize="@dimen/text_display"
                            app:autoSizeMinTextSize="@dimen/text_headline"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform"
                            tools:text="-LKR 42.15" />

                        <TextView
                            android:id="@+id/textSummaryTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.SpendWise.Title"
                            tools:text="Tesco Metro" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:layout_marginBottom="@dimen/spacing_md"
                            android:background="@color/outline_variant" />

                        <TextView
                            android:id="@+id/textSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingMultiplier="1.5"
                            android:textAppearance="@style/TextAppearance.SpendWise.Body"
                            tools:text="Groceries · Card\n12 Aug 2026\nweekly shop" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/dividerButtons"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/outline_variant"
        app:layout_constraintBottom_toTopOf="@id/layoutButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/spacing_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPrevious"
            style="@style/Widget.SpendWise.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/add_back"
            android:visibility="invisible"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNext"
            style="@style/Widget.SpendWise.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/add_next" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
