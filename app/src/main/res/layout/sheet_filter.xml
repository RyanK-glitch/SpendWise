<?xml version="1.0" encoding="utf-8"?>
<!-- The filter sheet. Six criteria, applied only when Apply is pressed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_xs">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/transactions_filter_title"
            android:textAppearance="@style/TextAppearance.SpendWise.Headline" />

        <ImageButton
            android:id="@+id/buttonClose"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_clear"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/spacing_lg"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/transactions_filter_type"
                android:textAppearance="@style/TextAppearance.SpendWise.SectionLabel" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:chipSpacingHorizontal="@dimen/spacing_sm"
                app:chipSpacingVertical="@dimen/spacing_xs"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeAll"
                    style="@style/Widget.SpendWise.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/transactions_type_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeIncome"
                    style="@style/Widget.SpendWise.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transactions_type_income" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeExpense"
                    style="@style/Widget.SpendWise.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transactions_type_expense" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/transactions_filter_category"
                android:textAppearance="@style/TextAppearance.SpendWise.SectionLabel" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:chipSpacingHorizontal="@dimen/spacing_sm"
                app:chipSpacingVertical="@dimen/spacing_xs"
                tools:ignore="MissingConstraints" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/transactions_filter_payment"
                android:textAppearance="@style/TextAppearance.SpendWise.SectionLabel" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:chipSpacingHorizontal="@dimen/spacing_sm"
                app:chipSpacingVertical="@dimen/spacing_xs" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/transactions_filter_date"
                android:textAppearance="@style/TextAppearance.SpendWise.SectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SpendWise.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="@string/transactions_filter_from"
                    app:endIconContentDescription="@string/transactions_filter_from"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom"
                    app:errorEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDateFrom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:textAppearance="@style/TextAppearance.SpendWise.Body"
                        android:textColor="@color/text_primary"
                        tools:text="1 Aug 2026" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SpendWise.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="@string/transactions_filter_to"
                    app:endIconContentDescription="@string/transactions_filter_to"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom"
                    app:errorEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editDateTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:textAppearance="@style/TextAppearance.SpendWise.Body"
                        android:textColor="@color/text_primary"
                        tools:text="31 Aug 2026" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/transactions_filter_amount"
                android:textAppearance="@style/TextAppearance.SpendWise.SectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutAmountMin"
                    style="@style/Widget.SpendWise.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="@string/transactions_filter_min"
                    app:errorEnabled="true"
                    app:prefixText="LKR">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editAmountMin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:textAppearance="@style/TextAppearance.SpendWise.Body"
                        android:textColor="@color/text_primary"
                        tools:text="10.00" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutAmountMax"
                    style="@style/Widget.SpendWise.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:hint="@string/transactions_filter_max"
                    app:errorEnabled="true"
                    app:prefixText="LKR">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editAmountMax"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_target_min"
                        android:textAppearance="@style/TextAppearance.SpendWise.Body"
                        android:textColor="@color/text_primary"
                        tools:text="250.00" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline_variant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClear"
            style="@style/Widget.SpendWise.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/transactions_clear_filters" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonApply"
            style="@style/Widget.SpendWise.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/transactions_apply_filters" />
    </LinearLayout>
</LinearLayout>
